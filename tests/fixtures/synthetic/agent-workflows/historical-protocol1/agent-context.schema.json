              },
              "required": [
                "sequence",
                "transactionId",
                "changeSha256"
              ],
              "type": "object"
            },
            "offset": {
              "minimum": 1,
              "type": "integer"
            },
            "personId": {
              "minLength": 1,
              "type": "string"
            },
            "requestSha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "taskId": {
              "enum": [
                "inspect",
                "import",
                "query",
                "correct",
                "export",
                "verify",
                "migrate"
              ]
            }
          },
          "required": [
            "personId",
            "taskId",
            "base",
            "requestSha256",
            "offset"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
