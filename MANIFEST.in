# Retain the corrected installed oracle and its focused regressions in the sdist.
include tests/qualify_source_disclosure_installed.py
include tests/test_source_disclosure.py

# Keep the independent history test's retained source, candidate and oracle in sdists.
recursive-include tests/fixtures/synthetic/clinical-history/oracle *.json *.md
include tests/fixtures/expected/clinical-history-facts.json

recursive-include tests/fixtures/synthetic/ocr *.pdf *.md *.py
include tests/fixtures/expected/ocr-facts.json
