root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces can be an intentional Markdown line break.
trim_trailing_whitespace = false

# Exact upstream bytes (including CRLF/BOMs) must never be normalized.
[definitions/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
