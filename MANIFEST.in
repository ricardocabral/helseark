include LICENSE NOTICE SECURITY.md CONTRIBUTING.md AGENTS.md CLAUDE.md
include tests/fixture-manifest.json tests/family_oracle.py
recursive-include tests/fixtures *.json *.md *.txt *.pdf *.csv *.py
recursive-include examples/synthetic-family *.md *.json *.py
prune docs/internal
prune .worktrees
recursive-include scripts *.py
# Retain the corrected installed oracle and its focused regressions in the sdist.
include tests/qualify_source_disclosure_installed.py
include tests/test_source_disclosure.py
include README.md AGENTS.md CLAUDE.md pyproject.toml uv.lock
recursive-include docs *.md
recursive-include tests *.py *.json *.txt *.md *.pdf
global-exclude *.pyc
recursive-include tests/fixtures LICENSE
include tests/qualify_validator_authority.py
include tests/qualify_validator_requests.py
include tests/setup_validator_legacy.py
recursive-include tests/fixtures/synthetic/validator-legacy *
include tests/qualify_official_validator.py


# Keep the independent history test's retained source, candidate and oracle in sdists.
recursive-include tests/fixtures/synthetic/clinical-history/oracle *.json *.md
include tests/fixtures/expected/clinical-history-facts.json

recursive-include tests/fixtures/synthetic/ocr *.pdf *.md *.py
include tests/fixtures/expected/ocr-facts.json
include tests/qualify_intake_history_presentation_installed.py
recursive-include tests/fixtures/synthetic/structured *.json *.csv *.md
recursive-include tests/fixtures/synthetic/clinical-history *.json *.md
