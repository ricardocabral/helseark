{
  "$id": "urn:helseark:schema:0.1.0:evidence",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "entries": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "user-entry",
                  "generated"
                ]
              },
              "pointer": {
                "type": "string"
              },
              "resourceRef": {
                "type": "string"
              },
              "rule": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "resourceRef",
              "pointer",
              "kind",
              "value",
              "rule"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "extraction": {
                "additionalProperties": false,
                "properties": {
                  "method": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "tool": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "version": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "method",
                  "tool",
                  "version"
                ],
                "type": "object"
              },
              "kind": {
                "const": "source"
              },
              "locator": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "json-pointer"
                      },
                      "pointer": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "pointer"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "end": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "extractionSha256": {
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "kind": {
                        "const": "text-span"
                      },
                      "start": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "kind",
                      "extractionSha256",
                      "start",
                      "end"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "column": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "delimiter": {
                        "maxLength": 1,
                        "minLength": 1,
                        "type": "string"
                      },
                      "kind": {
                        "const": "csv-cell"
                      },
                      "row": {
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "kind",
                      "row",
                      "column",
                      "delimiter"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "bbox": {
                        "items": {
                          "type": "number"
                        },
                        "maxItems": 4,
                        "minItems": 4,
                        "type": "array"
                      },
                      "coordinateSpace": {
                        "const": "displayed-cropbox-top-left-normalized"
                      },
                      "extractionSha256": {
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "kind": {
                        "const": "pdf-page"
                      },
                      "page": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "pageRotationApplied": {
                        "enum": [
                          0,
                          90,
                          180,
                          270
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "page",
                      "extractionSha256",
                      "coordinateSpace",
                      "pageRotationApplied"
                    ],
                    "type": "object"
                  }
                ]
              },
              "quote": {
                "minLength": 1,
                "type": "string"
              },
              "sourceDocument": {
                "minLength": 1,
                "type": "string"
              },
              "sourceSha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "target": {
                "additionalProperties": false,
                "properties": {
                  "pointers": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "reference": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "reference",
                  "pointers"
                ],
                "type": "object"
              },
              "transformation": {
                "additionalProperties": false,
                "properties": {
                  "description": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "rule": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "rule"
                ],
                "type": "object"
              }
            },
            "required": [
              "kind",
              "target",
              "sourceSha256",
              "sourceDocument",
              "quote",
              "locator"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "generated"
              },
              "rule": {
                "minLength": 1,
                "type": "string"
              },
              "target": {
                "additionalProperties": false,
                "properties": {
                  "pointers": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "reference": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "reference",
                  "pointers"
                ],
                "type": "object"
              }
            },
            "required": [
              "kind",
              "target",
              "rule"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "user-entry"
              },
              "rule": {
                "minLength": 1,
                "type": "string"
              },
              "target": {
                "additionalProperties": false,
                "properties": {
                  "pointers": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "reference": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "reference",
                  "pointers"
                ],
                "type": "object"
              },
              "value": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "kind",
              "target",
              "value",
              "rule"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "personId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "personId",
    "entries"
  ],
  "type": "object"
}
