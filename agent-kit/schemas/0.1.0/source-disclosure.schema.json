{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "helseark-source-plan-1"
        },
        "planId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "vaultId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "personId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "head": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "transactionId",
            "changeSha256"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "transactionId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "changeSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "full-person",
                "selected-current"
              ]
            },
            "resourceRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "resourceType": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "versionId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "resourceType",
                  "id",
                  "versionId"
                ]
              }
            },
            "includeSources": {
              "const": true
            }
          },
          "required": [
            "mode",
            "resourceRefs",
            "includeSources"
          ]
        },
        "referenceMap": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "personId",
              "resourceType",
              "id",
              "versionId",
              "fullUrl",
              "references"
            ],
            "properties": {
              "personId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "resourceType": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "versionId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "fullUrl": {
                "type": "string"
              },
              "references": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "originalSources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mediaType": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "path",
              "sha256",
              "size",
              "mediaType"
            ]
          }
        },
        "sourceFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "size"
            ]
          }
        },
        "originalDisposition": {
          "enum": [
            "included-exact",
            "omitted-all"
          ]
        },
        "derivatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^derivatives/[0-9a-f]{64}/blob$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "mediaType": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "mapping": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "omissions": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "sourceSha256",
              "path",
              "sha256",
              "size",
              "mediaType",
              "mapping",
              "omissions"
            ]
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "format",
        "planId",
        "vaultId",
        "personId",
        "head",
        "selection",
        "referenceMap",
        "originalSources",
        "sourceFiles",
        "originalDisposition",
        "derivatives",
        "limitations"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "helseark-source-decision-1"
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "humanReviewed": {
          "const": true
        },
        "confirmedPerson": {
          "const": true
        },
        "acknowledgedDisclosure": {
          "const": true
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "local-user",
                "synthetic-test"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "label"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "format",
        "planSha256",
        "humanReviewed",
        "confirmedPerson",
        "acknowledgedDisclosure",
        "reviewer",
        "reason"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "helseark-source-review-1"
        },
        "planId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "const": "helseark-source-decision-1"
            },
            "planSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "humanReviewed": {
              "const": true
            },
            "confirmedPerson": {
              "const": true
            },
            "acknowledgedDisclosure": {
              "const": true
            },
            "reviewer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "local-user",
                    "synthetic-test"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "kind",
                "label"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "format",
            "planSha256",
            "humanReviewed",
            "confirmedPerson",
            "acknowledgedDisclosure",
            "reviewer",
            "reason"
          ]
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "format",
        "planId",
        "decision",
        "reviewedAt"
      ]
    }
  ]
}
