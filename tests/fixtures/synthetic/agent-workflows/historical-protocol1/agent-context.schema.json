{
  "$id": "urn:helseark:schema:0.1.0:agent-context",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "availability": {
      "additionalProperties": false,
      "properties": {
        "missingCapabilities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        }
      },
      "required": [
        "status",
        "missingCapabilities"
      ],
      "type": "object"
    },
    "base": {
      "additionalProperties": false,
      "properties": {
        "changeSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "transactionId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "transactionId",
        "changeSha256"
      ],
      "type": "object"
    },
    "continuation": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "base": {
              "additionalProperties": false,
              "properties": {
                "changeSha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "sequence": {
                  "minimum": 1,
                  "type": "integer"
                },
                "transactionId": {
                  "minLength": 1,
                  "type": "string"
